<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>studio.reims.clip-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/usr/local/bin/reims-clip-agent.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REIMS_BRIDGE_TOKEN</key>
    <string>REPLACE_WITH_GENERATED_TOKEN</string>
    <key>REIMS_BRIDGE_PORT</key>
    <string>8080</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/reims-clip-agent.err.log</string>
</dict>
</plist>
